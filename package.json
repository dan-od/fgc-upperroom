{
  "name": "fgc-upper-room-mgbuoba",
  "version": "2.0.0",
  "description": "FGC Upper Room Mgbuoba - Youth Fellowship Website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run kill-ports && npm run preflight && concurrently -k -n WEB,BACKEND_API,BOT,WORKER,ATTENDANCE -c cyan,yellow,green,blue,magenta \"npm:dev:web\" \"npm:dev:api\" \"npm:bot:dev\" \"npm:bot:worker\" \"npm:attendance:dev\"",
    "kill-ports": "fuser -k 3000/tcp 3001/tcp 4100/tcp 4201/tcp 2>/dev/null; true",
    "dev:web": "vite --host --port 3000",
    "dev:api": "API_ONLY=true PORT=3001 tsx watch server.ts",
    "preflight": "node scripts/preflight.mjs",
    "test": "npm run test:unit",
    "test:api": "tsx --test tests/api-routing.test.mjs",
    "test:unit": "node --test bot/tests/unit/*.test.mjs",
    "test:integration": "WHATSAPP_PROVIDER=stub BOT_ADMIN_API_KEY=test-admin node --test bot/tests/integration/*.test.mjs",
    "test:e2e": "WHATSAPP_PROVIDER=stub BOT_ADMIN_API_KEY=test-admin node --test bot/tests/e2e/*.test.mjs",
    "dev:server": "tsx watch server.ts",
    "env:parity": "node scripts/check-env-parity.mjs",
    "bot:schema:ensure": "node scripts/ensure-bot-schema.mjs",
    "attendance:dev": "node --watch attendance/app.js",
    "attendance:start": "node attendance/app.js",
    "build": "vite build",
    "preview": "vite preview",
    "bot:dev": "node --watch bot/src/index.js",
    "bot:start": "node bot/src/index.js",
    "bot:worker": "node bot/src/worker.js",
    "bot:validate": "node bot/scripts/validate.js",
    "ops:backup-drill": "bash bot/scripts/backup-drill.sh",
    "ops:verify-https": "bash bot/scripts/verify-https.sh",
    "bot:test-messages": "node bot/scripts/test-messages.js",
    "bot:load-test": "node bot/scripts/load-test.js",
    "qa:load": "WHATSAPP_PROVIDER=stub node bot/scripts/load-test.js",
    "qa:performance": "WHATSAPP_PROVIDER=stub node scripts/perf-smoke.mjs",
    "qa:security": "WHATSAPP_PROVIDER=stub BOT_ADMIN_API_KEY=test-admin node scripts/security-smoke.mjs",
    "qa:accessibility": "node scripts/accessibility-smoke.mjs",
    "qa:ci": "npm run bot:schema:ensure && npm run test:integration && npm run test:e2e && npm run qa:accessibility && npm run qa:performance && npm run qa:security && npm run qa:load -- 25",
    "openclaw:hook:test": "node scripts/openclaw-hook-test.mjs"
  },
  "dependencies": {
    "bullmq": "^5.56.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "google-auth-library": "^10.6.1",
    "ioredis": "^5.8.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.35.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}

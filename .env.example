# ========================================
# FGC Upper Room - Environment Variables
# ========================================

# ----------------------------------------
# YouTube Data API Configuration
# ----------------------------------------
# Get your API key from https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=""
# Find your Channel ID at https://www.youtube.com/account_advanced
YOUTUBE_CHANNEL_ID=""

# ----------------------------------------
# Admin Center Access
# ----------------------------------------
# Password for /admin route (frontend authentication)
VITE_ADMIN_PASSWORD="your_secure_password_here"
# Seeded server-side admin account for /api/admin/auth/*
ADMIN_DEFAULT_EMAIL=admin@upperroom.local
ADMIN_DEFAULT_PASSWORD=ChangeMe1234
# Secret for bot admin APIs (x-bot-admin-key header)
BOT_ADMIN_API_KEY="set_a_long_random_secret"

# ----------------------------------------
# Bot Server Configuration
# ----------------------------------------
BOT_PORT=4100
BOT_HOST=0.0.0.0
BOT_TIMEZONE=Africa/Lagos
PUBLIC_SITE_BASE_URL=https://fgcmgbuoba.org
ENABLE_SCHEDULER=false

# ----------------------------------------
# Database (PostgreSQL)
# ----------------------------------------
DATABASE_URL=postgresql://user:password@localhost/church_bot

# ----------------------------------------
# Queue (Redis)
# ----------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ----------------------------------------
# Public base URL used inside attendance and social QR links
# Example local-network value: http://192.168.1.20:4201
# ----------------------------------------
ATTENDANCE_PUBLIC_BASE_URL=

# ----------------------------------------
# Public bot URL (used by SSL verification tooling)
# ----------------------------------------
BOT_PUBLIC_BASE_URL=https://bot.yourchurch.org

# ----------------------------------------
# Contact form webhooks (optional)
# ----------------------------------------
CONTACT_AUTORESPONSE_WEBHOOK_URL=
CONTACT_ADMIN_NOTIFICATION_WEBHOOK_URL=

# ----------------------------------------
# Permanent social redirect targets for QR links (optional overrides)
# ----------------------------------------
SOCIAL_LINK_FACEBOOK=
SOCIAL_LINK_INSTAGRAM=
SOCIAL_LINK_YOUTUBE=
SOCIAL_LINK_X=
SOCIAL_LINK_TIKTOK=

# ----------------------------------------
# WhatsApp Provider (meta or stub)
# ----------------------------------------
WHATSAPP_PROVIDER=meta
WHATSAPP_FALLBACK_PROVIDER=stub
WHATSAPP_CIRCUIT_FAILURE_THRESHOLD=5
WHATSAPP_CIRCUIT_COOLDOWN_MS=120000
REMINDER_RATE_LIMIT_MAX_PER_MINUTE=60
REMINDER_RATE_LIMIT_MIN_PER_MINUTE=10

# ----------------------------------------
# Meta WhatsApp Cloud API
# ----------------------------------------
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_PHONE_NUMBER_ID=123456789012345
META_WABA_ID=987654321098765
META_WEBHOOK_VERIFY_TOKEN=fgc-upperroom-webhook-2026
META_APP_SECRET=abcdef1234567890abcdef1234567890
META_API_VERSION=v21.0

# ----------------------------------------
# LLM Routing (auto, vertex, openai, gemini, none)
# auto order: vertex → openai → gemini → static templates
# ----------------------------------------
LLM_PROVIDER=auto

# ----------------------------------------
# Vertex AI Gemini (preferred in production — service account auth)
# ----------------------------------------
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
# VERTEX_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ----------------------------------------
# OpenAI
# ----------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------
# Google Gemini direct API
# ----------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ----------------------------------------
# Monitoring (optional)
# ----------------------------------------
ALERT_WEBHOOK_URL=https://your-monitoring-service.com/webhook
MONITORING_SLOW_QUERY_MS=300
MONITORING_SLOW_REQUEST_MS=1200

# ----------------------------------------
# OpenClaw sidecar integration (optional)
# ----------------------------------------
# Example hook URL: http://127.0.0.1:8787/hooks/wake
OPENCLAW_HOOK_URL=
OPENCLAW_HOOK_TOKEN=
OPENCLAW_HOOK_MODE=now
OPENCLAW_HOOK_TIMEOUT_MS=5000

# ----------------------------------------
# Frontend RUM (real user monitoring)
# ----------------------------------------
VITE_RUM_ENABLED=true
VITE_RUM_ENDPOINT=/fgc-testing/api/observability/rum

# FGC Upper Room - Environment Variables
# Copy this file to .env, then fill the values that match your setup.

# ------------------------------------------------------------------
# Core runtime and path overrides
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_ONLY=false
BOT_PORT=4100
BOT_HOST=0.0.0.0
BOT_TIMEZONE=Africa/Lagos
ENABLE_SCHEDULER=false
PUBLIC_SITE_BASE_URL=https://fgcmgbuoba.org
BOT_PUBLIC_BASE_URL=https://bot.yourchurch.org
APP_BASE_PATH=/fgc-testing/
PUBLIC_APP_BASE_PATH=/fgc-testing/
VITE_APP_BASE_PATH=/fgc-testing/
VITE_API_BASE_URL=
VITE_BOT_API_URL=
VITE_ATTENDANCE_API_URL=
VITE_LIVE_STREAM_URL=https://www.youtube.com/@theupperroom_4sq/live
APP_DATA_DIR=data
APP_PUBLIC_DIR=public
APP_DIST_DIR=dist
ATTENDANCE_PORT=4201
ATTENDANCE_PUBLIC_BASE_URL=
# true forces the Sunday window open for testing, false keeps normal Lagos-time rules.
ATTENDANCE_TEST_OPEN=false
ATTENDANCE_HISTORY_API_URL=http://localhost:4100/bot/api/attendance-history
ATTENDANCE_HISTORY_SYNC_KEY=
BOT_API_URL=http://localhost:4100

# ------------------------------------------------------------------
# Admin access
# ------------------------------------------------------------------
ADMIN_DEFAULT_EMAIL=admin@upperroom.local
ADMIN_DEFAULT_PASSWORD=ChangeMe1234
ADMIN_EMAIL=
ADMIN_PASSWORD=
BOT_ADMIN_API_KEY=set_a_long_random_secret
ATTENDANCE_ADMIN_KEY=
ATTENDANCE_ADMIN_PASSWORD=

# ------------------------------------------------------------------
# Database and queue
# ------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost/church_bot
REDIS_URL=redis://127.0.0.1:6379
DB_PASSWORD=strongpass

# ------------------------------------------------------------------
# Giving (Paystack + transfer options)
# ------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_PAYSTACK_PUBLIC_KEY must equal PAYSTACK_PUBLIC_KEY. PAYSTACK_PUBLIC_KEY is read server-side
# and returned via GET /api/giving/config; VITE_PAYSTACK_PUBLIC_KEY is the Vite build-time fallback.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GIVING_CURRENCY=NGN
GIVING_CALLBACK_URL=
# Canonical bank accounts config. GIVING_BANK_TRANSFER_ACCOUNTS_JSON, GIVING_BANKS_JSON, and
# GIVING_BANK_OPTIONS_JSON are deprecated aliases — remove them from deployments and use this one.
# Example: [{"id":"zenith-main","bankName":"Zenith Bank","accountName":"FOURSQUARE GOSPEL CHURCH, MGBUOBA","accountNumber":"1010799342","instructions":"Use the generated reference as your transfer narration.","details":[{"label":"Branch","value":"Mgbuoba"}]}]
GIVING_BANK_ACCOUNTS_JSON=
GIVING_BANK_NAME=
GIVING_BANK_ACCOUNT_NAME=
GIVING_BANK_ACCOUNT_NUMBER=
GIVING_BANK_TRANSFER_INSTRUCTIONS=
# Optional extra rows for the legacy single-bank fallback.
GIVING_BANK_DETAILS_JSON=
GIVING_ENABLE_CRYPTO=false
# Canonical crypto wallet address — ETHEREUM_WALLET_ADDRESS and CRYPTO_WALLET_ADDRESS are deprecated aliases.
GIVING_CRYPTO_WALLET_ADDRESS=
GIVING_CRYPTO_RPC_URL=
ETHERSCAN_API_KEY=
BITCOIN_WALLET_ADDRESS=
SEPOLIA_RPC_URL=https://rpc.ankr.com/eth_sepolia/...
PAYSTACK_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# WhatsApp (Meta Cloud API)
# ------------------------------------------------------------------
WHATSAPP_PROVIDER=meta
WHATSAPP_FALLBACK_PROVIDER=stub
WHATSAPP_CIRCUIT_FAILURE_THRESHOLD=5
WHATSAPP_CIRCUIT_COOLDOWN_MS=120000
REMINDER_RATE_LIMIT_MAX_PER_MINUTE=60
REMINDER_RATE_LIMIT_MIN_PER_MINUTE=10
META_ACCESS_TOKEN=EAA...
META_PHONE_NUMBER_ID=123456789012345
META_WABA_ID=987654321098765
META_WEBHOOK_VERIFY_TOKEN=fgc-upperroom-webhook-2026
META_APP_SECRET=abcdef1234567890abcdef1234567890
META_API_VERSION=v21.0

# ------------------------------------------------------------------
# LLM routing
# ------------------------------------------------------------------
# auto tries Vertex -> OpenAI -> Gemini -> static templates.
LLM_PROVIDER=auto
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_SERVICE_ACCOUNT_JSON=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------
# Monitoring, RUM, and OpenClaw
# ------------------------------------------------------------------
ALERT_WEBHOOK_URL=
MONITORING_SLOW_QUERY_MS=300
MONITORING_SLOW_REQUEST_MS=1200
OPENCLAW_HOOK_URL=
OPENCLAW_HOOK_TOKEN=
OPENCLAW_HOOK_MODE=now
OPENCLAW_HOOK_TIMEOUT_MS=5000
VITE_RUM_ENABLED=true
VITE_RUM_ENDPOINT=/fgc-testing/api/observability/rum

# ------------------------------------------------------------------
# Tooling and maintenance
# ------------------------------------------------------------------
TARGET_URL=https://bot.yourchurch.org
TEMP_DB_NAME=church_bot_drill
PERF_REQUESTS=60
PERF_P95_MS=450

# ------------------------------------------------------------------
# Content and contact helpers
# ------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
CONTACT_AUTORESPONSE_WEBHOOK_URL=
CONTACT_ADMIN_NOTIFICATION_WEBHOOK_URL=
SOCIAL_LINK_FACEBOOK=
SOCIAL_LINK_INSTAGRAM=
SOCIAL_LINK_YOUTUBE=
SOCIAL_LINK_X=
SOCIAL_LINK_TIKTOK=
